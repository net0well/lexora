{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Messaging": {
    "IngestionParallelism": 4,
    "EmbeddingParallelism": 1,
    "PreFetchCount": 10
  },
  "Ingestion": {
    "StalledAfter": "00:30:00",
    "EmbeddingBatchSize": 32
  },
  "DocumentProcessing": {
    "MaxPages": 2000,
    "MaxCells": 500000
  },
  "Maintenance": {
    "StalledDocumentsInterval": "00:05:00",
    "OrphanFilesInterval": "1.00:00:00",
    "ExpiredRefreshTokensInterval": "1.00:00:00"
  },
  "Persistence": {
    "WolverineSchema": "wolverine_worker"
  },
  "Storage": {
    "Provider": "S3",
    "S3": {
      "Bucket": "lexora-documents",
      "Region": "us-east-1",
      "ForcePathStyle": true
    }
  },
  "Ai": {
    "Embedding": {
      "Profile": "local",
      "Dimensions": 1024,
      "Profiles": {
        "local": {
          "Provider": "Ollama",
          "Endpoint": "http://localhost:11434",
          "Model": "bge-m3",
          "MaxBatchSize": 32
        },
        "fake": {
          "Provider": "Fake",
          "Model": "fake-embedding",
          "MaxBatchSize": 64
        }
      }
    }
  }
}
