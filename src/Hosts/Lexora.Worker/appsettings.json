{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Persistence": {
    "WolverineSchema": "wolverine_worker"
  },
  "Storage": {
    "Provider": "S3",
    "S3": {
      "Bucket": "lexora-documents",
      "Region": "us-east-1",
      "ForcePathStyle": true
    }
  }
}
