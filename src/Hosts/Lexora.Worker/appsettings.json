{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Persistence": {
    "WolverineSchema": "wolverine_worker"
  },
  "Storage": {
    "Provider": "S3",
    "S3": {
      "Bucket": "lexora-documents",
      "Region": "us-east-1",
      "ForcePathStyle": true
    }
  },
  "Ai": {
    "Embedding": {
      "Profile": "local",
      "Dimensions": 1024,
      "Profiles": {
        "local": {
          "Provider": "Ollama",
          "Endpoint": "http://localhost:11434",
          "Model": "bge-m3",
          "MaxBatchSize": 32
        },
        "fake": {
          "Provider": "Fake",
          "Model": "fake-embedding",
          "MaxBatchSize": 64
        }
      }
    }
  }
}
