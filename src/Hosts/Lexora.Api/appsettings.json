{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Persistence": {
    "WolverineSchema": "wolverine_api"
  },
  "Swagger": {
    "Enabled": false
  },
  "Storage": {
    "Provider": "S3",
    "S3": {
      "Bucket": "lexora-documents",
      "Region": "us-east-1",
      "ForcePathStyle": true
    }
  },
  "Ai": {
    "Chat": {
      "DefaultProfile": "local",
      "Profiles": {
        "local": {
          "Provider": "Ollama",
          "Endpoint": "http://localhost:11434",
          "Model": "qwen2.5:7b",
          "AllowUserSelection": true
        },
        "claude": {
          "Provider": "Anthropic",
          "Model": "claude-sonnet-5-5",
          "MaxOutputTokens": 16000,
          "AllowUserSelection": true
        },
        "openai": {
          "Provider": "OpenAI",
          "Model": "gpt-5-mini",
          "AllowUserSelection": true
        },
        "groq": {
          "Provider": "OpenAICompatible",
          "Endpoint": "https://api.groq.com/openai/v1",
          "Model": "openai/gpt-oss-120b",
          "AllowUserSelection": false
        },
        "fake": {
          "Provider": "Fake",
          "Model": "fake-chat",
          "AllowUserSelection": false
        }
      }
    },
    "Embedding": {
      "Profile": "local",
      "Dimensions": 1024,
      "Profiles": {
        "local": {
          "Provider": "Ollama",
          "Endpoint": "http://localhost:11434",
          "Model": "bge-m3",
          "MaxBatchSize": 32
        },
        "openai": {
          "Provider": "OpenAI",
          "Model": "text-embedding-3-small",
          "MaxBatchSize": 128
        },
        "fake": {
          "Provider": "Fake",
          "Model": "fake-embedding",
          "MaxBatchSize": 64
        }
      }
    }
  }
}
